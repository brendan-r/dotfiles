#!/usr/bin/env sh

#  - - -  Window behaviour  - - -
# Use the current Yabai settings; the retired built-in bar/border settings
# no longer exist. The native menu bar and existing keyboard bindings remain.

# Shadows and opacity keep their native defaults; changing them needs the
# optional scripting addition, which this setup does not install.

# global settings
yabai -m config mouse_follows_focus          off
yabai -m config focus_follows_mouse          off
yabai -m config window_placement             second_child
yabai -m config split_ratio                  0.50
yabai -m config auto_balance                 off
yabai -m config mouse_modifier               fn
yabai -m config mouse_action1                move
yabai -m config mouse_action2                resize

# general space settings
yabai -m config layout                       bsp
yabai -m config top_padding                  20
yabai -m config bottom_padding               20
yabai -m config left_padding                 20
yabai -m config right_padding                20
yabai -m config window_gap                   10


# Your custom stuff

# This is to manage the R plot windows generated by Quartz on macos
yabai -m rule --add app="^XQuartz$" manage=on
yabai -m rule --add app="^(System Preferences|System Settings)$" manage=off
yabai -m rule --add app="mpv" manage=on
yabai -m rule --add app="^Visual Studio Code$" manage=on


echo "yabai configuration loaded.."
