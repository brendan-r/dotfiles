#!/bin/bash
# Bootstrap intentionally stands alone: it can be downloaded before the repo exists.
set -eo pipefail
fail() { printf 'dotfiles: %s\n' "$*" >&2; exit 1; }
usage() {
    cat <<'USAGE'
Usage: dotfiles install [--backup]
       dotfiles bootstrap [--repo URL] [--ref REVISION] [--directory PATH] [--backup]

Git must already be installed. No packages, credentials, or OS preferences are changed.
Existing checkouts are reused without updating or discarding local changes.
USAGE
}
platform() {
    case "$(uname -s)" in
        Darwin) printf 'macos\n' ;;
        Linux)
            [ -r /etc/os-release ] || fail 'Unsupported Linux distribution (expected Debian).'
            # shellcheck disable=SC1091
            . /etc/os-release
            [ "${ID:-}" = debian ] || fail 'Unsupported Linux distribution (expected Debian).'
            printf 'debian\n' ;;
        *) fail 'Supported systems: macOS and Debian.' ;;
    esac
}
require_git() {
    local git_path
    git_path=$(command -v git) || fail 'Git is required. Install Command Line Tools on macOS (xcode-select --install), or git on Debian (sudo apt install git ca-certificates).'
    if [ "$os" = macos ] && [ "$git_path" = /usr/bin/git ]; then
        /usr/bin/xcode-select -p >/dev/null 2>&1 || fail 'Git requires Command Line Tools. Run xcode-select --install, complete installation, then rerun bootstrap.'
    fi
    git --version >/dev/null 2>&1 || fail 'Git is not working. Repair its installation, then rerun bootstrap.'
}
canonical_repo() {
    local value=$1
    case "$value" in
        git@github.com:*) value="https://github.com/${value#git@github.com:}" ;;
    esac
    case "$value" in
        https://github.com/*) printf '%s\n' "${value%.git}" | tr '[:upper:]' '[:lower:]' ;;
        *) printf '%s\n' "$value" ;;
    esac
}
command_name=${1:---help}
case "$command_name" in --help|-h) usage; exit 0 ;; install|bootstrap) shift ;; *) usage >&2; exit 2 ;; esac
repository=https://github.com/brendan-r/dotfiles.git
revision=master
explicit_revision=false
destination=${HOME:?}/projects/dotfiles
backup=false
while [ "$#" -gt 0 ]; do
    case "$1" in
        --backup) backup=true; shift ;;
        --repo|--ref|--directory)
            [ "$command_name" = bootstrap ] || fail "$1 is only valid for bootstrap."
            if [ "$#" -lt 2 ] || [ -z "$2" ]; then fail "Missing value for $1."; fi
            case "$1" in
                --repo) repository=$2 ;;
                --ref) revision=$2; explicit_revision=true ;;
                --directory) destination=$2 ;;
            esac
            shift 2 ;;
        --help|-h) usage; exit 0 ;;
        *) fail "Unknown option: $1" ;;
    esac
done
[ "${EUID}" -ne 0 ] || fail 'Run as your normal user, without sudo.'
os=$(platform)
if [ "$command_name" = bootstrap ]; then
    require_git
    case "$repository" in -*) fail 'Repository must not begin with a dash.' ;; esac
    case "$revision" in -*) fail 'Revision must not begin with a dash.' ;; esac
    case "$destination" in /*) ;; *) destination="$PWD/$destination" ;; esac
    [ ! -L "$destination" ] || fail "Checkout destination is a symlink: $destination"
    if [ -e "$destination" ]; then
        [ -d "$destination/.git" ] || [ -f "$destination/.git" ] || fail "Destination is not a Git checkout: $destination"
        origin=$(git -C "$destination" remote get-url origin) || fail 'Existing checkout has no origin.'
        [ "$(canonical_repo "$origin")" = "$(canonical_repo "$repository")" ] || fail 'Existing checkout belongs to another repository.'
        if "$explicit_revision"; then
            requested=$(git -C "$destination" rev-parse --verify "$revision^{commit}") || fail 'Requested revision is not available in the existing checkout.'
            [ "$requested" = "$(git -C "$destination" rev-parse HEAD)" ] || fail 'Existing checkout is at another revision. Change it explicitly before rerunning.'
        fi
    else
        parent=$(dirname "$destination")
        mkdir -p "$parent"
        staging=$(mktemp -d "$parent/.dotfiles-clone.XXXXXX")
        trap 'rm -rf "$staging"' EXIT
        # Disable credential prompts; fetching this public repo requires no account.
        GIT_TERMINAL_PROMPT=0 git clone -- "$repository" "$staging/repo"
        if git -C "$staging/repo" rev-parse --verify "$revision^{commit}" >/dev/null 2>&1; then
            git -C "$staging/repo" checkout "$revision" --
        elif git -C "$staging/repo" show-ref --verify --quiet "refs/remotes/origin/$revision"; then
            git -C "$staging/repo" checkout -b "$revision" --track "origin/$revision"
        else
            fail "Requested revision does not identify a commit: $revision"
        fi
        mv "$staging/repo" "$destination"
        rm -rf "$staging"
        trap - EXIT
    fi
    args=(install)
    if "$backup"; then args+=(--backup); fi
    exec /bin/bash "$destination/dotfiles" "${args[@]}"
fi
root=$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)
args=("$root" "$os")
if "$backup"; then args+=(--backup); fi
exec /bin/bash "$root/os/create_symbolic_links.sh" "${args[@]}"
