#!/bin/bash
# Prompt construction must not emit output or query an absent terminal.
dotfiles_git_prompt() {
    local branch marks=''
    command -v git >/dev/null 2>&1 || return 0
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0
    branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null) || return 0
    git diff --quiet --ignore-submodules --cached || marks="${marks}+"
    git diff --quiet --ignore-submodules || marks="${marks}!"
    [ -z "$(git ls-files --others --exclude-standard)" ] || marks="${marks}?"
    git rev-parse --verify refs/stash >/dev/null 2>&1 && marks="${marks}$"
    printf ' on %s%s' "$branch" "${marks:+ [$marks]}"
}
# Retain the existing Solarized-style colors and Emacs terminal layout.
if [ "${TERM:-dumb}" != dumb ] && [ -n "${TERM:-}" ]; then
    if [ -n "${INSIDE_EMACS:-}" ]; then
        PS1='\[\e[0;36m\]\u\[\e[0m\]@\[\e[1;33m\]\h:\[\e[0;32m\]\w\[\e[0m\]$(dotfiles_git_prompt)\n$ '
    else
        PS1='\[\033]0;\w\007\]\[\e[38;5;166m\]\u\[\e[38;5;15m\]@\h: \[\e[38;5;64m\]\w\[\e[0m\]$(dotfiles_git_prompt)\n\[\e[38;5;15m\]\$ \[\e[0m\]'
    fi
else
    PS1='\u@\h:\w$(dotfiles_git_prompt)\n\$ '
fi
PS2='⚡ '
PS4='+ ${BASH_SOURCE}:${LINENO}: '
export LS_COLORS='no=0;35:di=1;35:ex=0;32:fi=0;35:ec=:mi=1;31:ln=target:or=31;01:'
if [ "${DOTFILES_OS:-}" = linux ] && command -v dircolors >/dev/null 2>&1; then
    if [ -r "$HOME/.dircolors" ]; then eval "$(dircolors -b "$HOME/.dircolors")"; else eval "$(dircolors -b)"; fi
    alias ls='ls --color=auto'
fi
